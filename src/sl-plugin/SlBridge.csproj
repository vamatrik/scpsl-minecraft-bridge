<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SlBridge</AssemblyName>
    <RootNamespace>SlBridge</RootNamespace>
    <Version>0.1.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Библиотеки игры берём из скопированного выделенного сервера -->
    <!-- Библиотеки игры берём из выделенного сервера SL (Steam). Свой путь: dotnet build -p:SLManaged=... -->
    <SLManaged Condition="'$(SLManaged)' == '' And Exists('C:\Program Files (x86)\Steam\steamapps\common\SCP Secret Laboratory Dedicated Server\SCPSL_Data\Managed')">C:\Program Files (x86)\Steam\steamapps\common\SCP Secret Laboratory Dedicated Server\SCPSL_Data\Managed</SLManaged>
    <SLManaged Condition="'$(SLManaged)' == ''">$(MSBuildThisFileDirectory)..\..\runtime\SLServer\SCPSL_Data\Managed</SLManaged>
  </PropertyGroup>
  <!-- Компилируем прямо против BCL игры (Unity Mono): в её mscorlib есть Span и т.п. -->
  <PropertyGroup>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoWarn>$(NoWarn);MSB3277;CS1701;CS1702</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="mscorlib"><HintPath>$(SLManaged)\mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(SLManaged)\System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(SLManaged)\System.Core.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(SLManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(SLManaged)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LabApi"><HintPath>$(SLManaged)\LabApi.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mirror"><HintPath>$(SLManaged)\Mirror.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(SLManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(SLManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(SLManaged)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(SLManaged)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="NorthwoodLib"><HintPath>$(SLManaged)\NorthwoodLib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CommandSystem.Core"><HintPath>$(SLManaged)\CommandSystem.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(SLManaged)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Pooling"><HintPath>$(SLManaged)\Pooling.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(SLManaged)\netstandard.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="sounds\scp096_rage.wav" LogicalName="SlBridge.sounds.scp096_rage.wav" />
  </ItemGroup>
</Project>
